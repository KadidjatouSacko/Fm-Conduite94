    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title> <!-- Le titre de chaque page sera dynamique -->
    <link rel="stylesheet" href="/css/style.css"> <!-- Ton fichier CSS global -->
</head>
<body>

